#!/bin/sh
# Keeps version.js in step with the changelog, for the version shown bottom right when the page is opened from a file.
cd "$(git rev-parse --show-toplevel)" || exit 0
version=$(grep -m1 '^### ' CHANGELOG.md | sed 's/### \([0-9.]*\).*/\1/')
printf "window.NETMAP_VERSION = { version: '%s' };\n" "$version" > version.js
git add version.js
